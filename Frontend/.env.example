# Base URL of your deployed backend (the Express service or Supabase Edge Function)
VITE_API_BASE_URL=VITE_API_BASE_URL=https://mp4-converter-production-07ae.up.railway.app/api

# Optional: only needed if you upgrade youtube.js from oEmbed to the official
# Data API v3 (for view counts, duration, etc). Get one from
# https://console.cloud.google.com/apis/credentials — this goes on the
# BACKEND only, never in frontend code or a VITE_ variable, since anything
# prefixed VITE_ is bundled into the public JS bundle and visible to anyone.
YOUTUBE_API_KEY=

# Optional: if you wire up Supabase for auth / history storage
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
